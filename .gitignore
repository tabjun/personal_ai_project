# .gitignore (루트용)

# 가상환경 폴더 무시
.venv/
venv/
env/

# 환경변수 및 키 파일 무시 (보안)
.env
*.ini
*.key
*.db*

# 파이썬 캐시 무시
__pycache__/
*.pyc
build/
dist/
wheels/
*.egg-info
*.python-version
.DS_Store

# VS Code 설정 무시
.vscode/
**/.vscode/*
!quantitative_trading/.vscode/
!quantitative_trading/.vscode/settings.json
!quantitative_trading/.vscode/extensions.json
.codex/
resume.pdf

# 에이전트 설정 및 로컬 스킬 제외 (Codex/Claude 스킬 다운로드 폴더)
.agents/
**/.agents/
**/.claude/settings.local.json

# AI 에이전트 작업 문서: 서버 ↔ 로컬 클로드/코덱스가 동일 지침/이력을 공유하도록 추적한다.
# 실제 시크릿/키 값은 포함하지 않음. .env/*.key/*.ini 등은 위에서 차단됨.
# AGENTS.md
# CLAUDE.md
# skills.md
# process.md
# history.md
# conversation_l2_cache.md

#  [개인정보 보호] 
result/

# 프로젝트별 간섭없게 상위 설정

# [job_hunter 관련]
resum/self_introduction
# more_info 폴더 내부는 전부 무시하되 특정 파일만 예외
resum/more_info/*
!resum/more_info/guideline.txt

# 3. knowledge 폴더 내부는 전부 무시하되 특정 파일만 예외
resum/self_introduction/*
# knowledge 폴더 내부는 전부 무시하되 특정 파일만 예외
resum/knowledge/*
!resum/knowledge/resume_example.md
!resum/knowledge/resume_example.txt


*.pdf
