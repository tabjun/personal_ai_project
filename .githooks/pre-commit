#!/bin/sh
set -eu
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(dirname -- "$hook_dir")
if command -v python >/dev/null 2>&1; then
    python_cmd=python
elif command -v python3 >/dev/null 2>&1; then
    python_cmd=python3
else
    echo "Python is required for the project isolation check." >&2
    exit 1
fi
"$python_cmd" "$root/tools/isolation/check.py"
branch=$(git branch --show-current)
worktree=$(git rev-parse --show-toplevel)
case "$branch" in
    stock|feature/stock/?*)
        stock_hook="$worktree/quantitative_trading/.githooks/pre-commit"
        if [ -f "$stock_hook" ]; then
            sh "$stock_hook"
            "$python_cmd" "$root/tools/isolation/check.py"
        fi
        ;;
esac
